# Specifies intentionally untracked files to ignore when using Git
# http://git-scm.com/docs/gitignore

# Angular build and cache
/.angular/cache
/.angular/*

# Capacitor
/ios/App/Pods/
/ios/App/App/public/
/ios/App/App/capacitor.config.json
/ios/capacitor-cordova-ios-plugins/
/ios/App/build/

# Environment files
/src/environments/environment.*.ts

# OS generated files
ehthumbs.db
Icon?
Desktop.ini

# VSCode settings
.vscode/

# Mac
*.DS_Store

# Windows
Thumbs.db
$RECYCLE.BIN/

# Logs
*.log
log.txt
npm-debug.log*

# Node
node_modules/

# Build output
/dist/
/www/
/coverage/

# Local Android SDK used for ad-hoc APK builds
/.android-sdk/
/.android-commandlinetools.zip

# Local Android release signing keys
/android/*.jks
/android/*.keystore
/android/release-signing.properties

# IDEs
.idea/
*.sublime-project
*.sublime-workspace

# Misc
*~
*.sw[mnpcod]
.tmp
*.tmp
*.tmp.*
.sass-cache/
.sourcemaps/
.versions/
/platforms/
# /plugins/
UserInterfaceState.xcuserstate

# Local iOS build intermediates
/work/

# Python release tooling
__pycache__/
*.pyc
