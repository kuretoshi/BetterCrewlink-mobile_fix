<?xml version="1.0" encoding="utf-8"?>
<network-security-config>
    <!-- Direct NoS connections require an explicitly user-installed CA. TLS validation remains enabled. -->
    <base-config>
        <trust-anchors>
            <certificates src="system" />
            <certificates src="user" />
        </trust-anchors>
    </base-config>
</network-security-config>
